@model ProyectoFinalG5.Models.Cliente

@{
    ViewData["Title"] = "Nuevo Cliente";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">

    <div class="card shadow-lg" style="width: 420px; border-radius: 15px;">

        <div class="card-body p-4">

            <h3 class="text-center mb-4">Nuevo Cliente</h3>

            <!-- Agregamos asp-action="Nuevo" para asegurar que envíe los datos al método correcto -->
            <form asp-action="Nuevo" method="post">

                <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <!-- Cambiamos name="Nombre" por asp-for="Nombre" -->
                    <input asp-for="Nombre" class="form-control" placeholder="Ingrese su nombre" />
                    <!-- Agregamos este span para que muestre el error si el nombre está vacío -->
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Teléfono</label>
                    <!-- Cambiamos name="Telefono" por asp-for="Telefono" -->
                    <input asp-for="Telefono" class="form-control" placeholder="Ingrese su teléfono" />
                    <!-- Agregamos este span para que muestre el error si el teléfono está vacío o es inválido -->
                    <span asp-validation-for="Telefono" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-success w-100">
                    Guardar Cliente
                </button>

                <a href="/Cliente/Listar" class="btn btn-secondary w-100 mt-2">
                    Cancelar
                </a>

            </form>

        </div>
    </div>
</div>

